{
  "name": "atomreactchamber",
  "version": "2.0.0",
  "private": true,
  "description": "AtomReactChamber v2 — laboratorio virtual de química gamificado para secundaria (UPT · Base de Datos II)",
  "author": "Adriana Rafaela Laos González",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend",
    "extensions/vscode",
    "integrations/mcp"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "seed:generate": "node db/scripts/generate-seed.mjs",
    "docs:readme": "node scripts/docs/build-readme.mjs",
    "docs:diagrams": "node scripts/docs/build-diagrams.mjs",
    "docs:api": "typedoc",
    "dev": "npm run dev -w frontend",
    "dev:api": "npm run dev -w backend"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laos19/demov0.1atomreactchamber.git"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "bcryptjs": "^3.0.3",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.3"
  }
}
