{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "noEmit": true,
    "lib": ["ES2023", "DOM"],
    "types": ["node", "vite/client"]
  },
  "include": ["backend/src", "frontend/src/engine", "frontend/src/data", "integrations/mcp/src"]
}
